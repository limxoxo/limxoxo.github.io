---
import FilterPanel from './FilterPanel.astro';
import Lightbox from './Lightbox.astro';
---

<FilterPanel />

<div id="galleryGrid" class="gallery-grid"></div>

<button id="scrollTopBtn" class="scroll-top-btn" aria-label="Scroll to top">↑</button>

<Lightbox />

<style is:global>
  @import '../styles/gallery.css';
</style>

<script is:inline>
  var currentAudio = null;
  var lbCards = [];
  var lbIndex = -1;

  window.onload = function() {
    fetch('/data/bird_data.json')
      .then(function(res) { return res.json(); })
      .then(function(birds) { initGalleryPage(birds); })
      .catch(function(err) { console.error('Error loading bird_data.json', err); });
  };

  function getColumnCount() {
    var w = window.innerWidth;
    if (w >= 1200) return 4;
    if (w >= 900) return 3;
    if (w >= 480) return 2;
    return 1;
  }

  function cardHTML(bird) {
    var audio = bird.audio || {};
    var audioSrc = audio.src || '';
    var audioCredit = audio.credit || '';
    return '<div class="bird-card" data-region="' + bird.region + '" data-date="' + (bird.date || '') + '">' +
      '<img' +
        ' src="' + bird.thumbAvif + '"' +
        ' class="bird-card-img"' +
        ' loading="lazy"' +
        ' decoding="async"' +
        ' data-large-avif="' + bird.largeAvif + '"' +
        ' data-title="' + bird.title + '"' +
        ' data-location="' + bird.region + '"' +
        ' data-place="' + bird.place + '"' +
        ' data-date="' + (bird.date || '') + '"' +
        ' data-audio="' + audioSrc + '"' +
        ' data-audio-credit="' + audioCredit + '"' +
        ' alt="' + bird.title + '">' +
      '<div class="bird-card-caption">' +
        '<div class="bird-card-name">' + bird.title + '</div>' +
        '<div class="bird-card-meta">' + bird.place + (bird.date ? ' &middot; ' + bird.date : '') + '</div>' +
      '</div>' +
    '</div>';
  }

  function initGalleryPage(birds) {
    var galleryGrid = document.getElementById('galleryGrid');
    if (!galleryGrid) return;

    birds = birds.slice().sort(function(a, b) {
      var dateCmp = (b.date || '').localeCompare(a.date || '');
      if (dateCmp !== 0) return dateCmp;
      return (b.id || 0) - (a.id || 0);
    });

    var numCols = getColumnCount();
    var cols = [];
    for (var i = 0; i < numCols; i++) cols.push([]);
    birds.forEach(function(bird, i) { cols[i % numCols].push(bird); });

    galleryGrid.innerHTML = cols.map(function(colBirds) {
      return '<div class="gallery-col">' + colBirds.map(cardHTML).join('') + '</div>';
    }).join('');

    var totalCountEl = document.getElementById('totalCount');
    if (totalCountEl) totalCountEl.textContent = birds.length;

    buildRegionFilters(birds);
    setupLightbox();
    setupSearchFilterRandom();
    setupScrollTop();
    setupCardAnimations();
  }

  // --- LIGHTBOX ---
  function getVisibleCards() {
    return Array.from(document.querySelectorAll('#galleryGrid .bird-card')).filter(function(c) {
      return c.style.display !== 'none';
    });
  }

  function openLightbox(card) {
    lbCards = getVisibleCards();
    lbIndex = lbCards.indexOf(card);
    showLightboxAt(lbIndex);

    var overlay = document.getElementById('lightboxOverlay');
    if (overlay) overlay.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  function showLightboxAt(idx) {
    lbCards = getVisibleCards();
    if (idx < 0 || idx >= lbCards.length) return;
    lbIndex = idx;

    var card = lbCards[idx];
    var img = card.querySelector('.bird-card-img');
    if (!img) return;

    var lbImg = document.getElementById('lightboxImage');
    var lbName = document.getElementById('lightboxName');
    var lbMeta = document.getElementById('lightboxMeta');
    var lbAttr = document.getElementById('lightboxAttribution');

    if (lbImg) {
      lbImg.style.transform = 'none';
      lbImg.src = img.dataset.largeAvif || img.src;
      lbImg.alt = img.alt;
    }
    if (lbName) lbName.textContent = img.dataset.title || img.alt || '';
    if (lbMeta) {
      var place = img.dataset.place || '';
      var date = img.dataset.date || '';
      lbMeta.textContent = [place, date].filter(Boolean).join(' · ');
    }
    if (lbAttr) lbAttr.textContent = img.dataset.audioCredit || '';

    if (currentAudio) { currentAudio.pause(); currentAudio = null; }
    var audioSrc = img.dataset.audio;
    if (audioSrc) {
      currentAudio = new Audio(audioSrc);
      currentAudio.play().catch(function() {});
    }
  }

  function closeLightbox() {
    var overlay = document.getElementById('lightboxOverlay');
    var lbImg = document.getElementById('lightboxImage');
    if (overlay) overlay.classList.remove('show');
    if (lbImg) { lbImg.src = ''; lbImg.style.transform = 'none'; }
    document.body.style.overflow = '';
    if (currentAudio) { currentAudio.pause(); currentAudio = null; }

    // Scroll back to the last viewed card
    if (lbIndex >= 0 && lbIndex < lbCards.length) {
      var card = lbCards[lbIndex];
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    lbIndex = -1;
  }

  function setupLightbox() {
    var overlay = document.getElementById('lightboxOverlay');
    var lbImg = document.getElementById('lightboxImage');
    var closeBtn = document.getElementById('lightboxClose');

    if (closeBtn) closeBtn.addEventListener('click', function(e) { e.stopPropagation(); closeLightbox(); });

    if (overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) closeLightbox();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (!overlay || !overlay.classList.contains('show')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showLightboxAt(lbIndex + 1);
      if (e.key === 'ArrowLeft') showLightboxAt(lbIndex - 1);
    });

    // Card click
    document.getElementById('galleryGrid').addEventListener('click', function(e) {
      var card = e.target.closest('.bird-card');
      if (card && card.style.display !== 'none') openLightbox(card);
    });

    // --- Touch: swipe to navigate + pinch to zoom ---
    if (!lbImg) return;

    var touchStartX = 0, touchStartY = 0;
    var touchCurX = 0;
    var isPinching = false;
    var pinchStartDist = 0;
    var pinchStartScale = 1;
    var imgScale = 1;
    var imgTranslateX = 0, imgTranslateY = 0;
    var panStartX = 0, panStartY = 0;

    function getTouchDist(t) {
      var dx = t[0].clientX - t[1].clientX;
      var dy = t[0].clientY - t[1].clientY;
      return Math.sqrt(dx * dx + dy * dy);
    }

    function applyTransform(animated) {
      lbImg.style.transition = animated ? 'transform 0.2s ease' : 'none';
      lbImg.style.transform = 'translate(' + imgTranslateX + 'px, ' + imgTranslateY + 'px) scale(' + imgScale + ')';
    }

    function resetZoom() {
      imgScale = 1; imgTranslateX = 0; imgTranslateY = 0;
      applyTransform(true);
    }

    var recentlyPinched = false;

    lbImg.addEventListener('touchstart', function(e) {
      if (e.touches.length === 2) {
        isPinching = true;
        recentlyPinched = true;
        pinchStartDist = getTouchDist(e.touches);
        pinchStartScale = imgScale;
        e.preventDefault();
      } else if (e.touches.length === 1) {
        isPinching = false;
        touchStartX = touchCurX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        if (imgScale > 1) {
          panStartX = imgTranslateX;
          panStartY = imgTranslateY;
        }
      }
    }, { passive: false });

    lbImg.addEventListener('touchmove', function(e) {
      e.preventDefault();
      if (e.touches.length === 2 && isPinching) {
        var dist = getTouchDist(e.touches);
        imgScale = Math.max(1, Math.min(5, pinchStartScale * (dist / pinchStartDist)));
        applyTransform(false);
      } else if (e.touches.length === 1 && !isPinching) {
        touchCurX = e.touches[0].clientX;
        if (imgScale > 1) {
          imgTranslateX = panStartX + (e.touches[0].clientX - touchStartX);
          imgTranslateY = panStartY + (e.touches[0].clientY - touchStartY);
          applyTransform(false);
        } else {
          var dx = touchCurX - touchStartX;
          lbImg.style.transition = 'none';
          lbImg.style.transform = 'translateX(' + dx + 'px)';
        }
      }
    }, { passive: false });

    lbImg.addEventListener('touchend', function(e) {
      if (isPinching || e.touches.length >= 2) return;
      if (e.touches.length === 0 && recentlyPinched) {
        // All fingers lifted after a pinch — just clean up, no swipe/double-tap
        isPinching = false;
        if (imgScale <= 1) resetZoom();
        setTimeout(function() { recentlyPinched = false; }, 400);
        return;
      }
      isPinching = false;
      var dx = touchCurX - touchStartX;
      if (imgScale > 1) return;
      if (Math.abs(dx) > 50) {
        if (dx < 0) showLightboxAt(lbIndex + 1);
        else showLightboxAt(lbIndex - 1);
      } else {
        lbImg.style.transition = 'transform 0.2s ease';
        lbImg.style.transform = 'none';
      }
    }, { passive: false });

    // Double-tap to reset zoom (only when not pinching)
    var lastTap = 0;
    lbImg.addEventListener('touchend', function(e) {
      if (recentlyPinched || isPinching) return;
      var now = Date.now();
      if (now - lastTap < 300) resetZoom();
      lastTap = now;
    });
  }

  // --- STAGGERED CARD ANIMATIONS ---
  function setupCardAnimations() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('#galleryGrid .bird-card').forEach(function(card) {
        card.classList.add('visible');
      });
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      var intersecting = entries
        .filter(function(e) { return e.isIntersecting; })
        .sort(function(a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });

      intersecting.forEach(function(entry, i) {
        entry.target.style.transitionDelay = (i * 60) + 'ms';
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });

    document.querySelectorAll('#galleryGrid .bird-card').forEach(function(card) {
      observer.observe(card);
    });
  }

  // --- REGION FILTERS ---
  function titleCase(str) {
    return (str || '').toLowerCase().split(' ').map(function(word) {
      if (!word) return '';
      return word.split('-').map(function(part) {
        if (!part) return '';
        return part.charAt(0).toUpperCase() + part.slice(1);
      }).join('-');
    }).join(' ').trim();
  }

  function buildRegionFilters(birds) {
    var regionFilters = document.getElementById('regionFilters');
    if (!regionFilters) return;

    var regions = Array.from(new Set(
      (birds || []).map(function(b) {
        return (b.region || '').toString().trim().toLowerCase();
      }).filter(Boolean)
    )).sort(function(a, b) { return a.localeCompare(b); });

    regionFilters.innerHTML = regions.map(function(region, idx) {
      var id = 'locAuto' + idx;
      var label = titleCase(region);
      return '<label class="region-chip" for="' + id + '">' +
        '<input class="location-checkbox" type="checkbox" id="' + id + '" value="' + region + '">' +
        label +
      '</label>';
    }).join('');
  }

  // --- SEARCH / FILTER / RANDOM ---
  function setupSearchFilterRandom() {
    var searchInput = document.getElementById('searchInput');
    var randomBtn = document.getElementById('randomBtn');
    var visibleCountEl = document.getElementById('visibleCount');
    var filterToggleBtn = document.getElementById('filterToggleBtn');
    var filterPanel = document.getElementById('filterPanel');

    var minMonthEl = document.getElementById('minMonth');
    var maxMonthEl = document.getElementById('maxMonth');
    var minMonthLabel = document.getElementById('minMonthLabel');
    var maxMonthLabel = document.getElementById('maxMonthLabel');

    function getCards() {
      return Array.from(document.querySelectorAll('#galleryGrid .bird-card'));
    }

    function parseYM(ym) {
      if (!ym || typeof ym !== 'string') return null;
      var m = ym.trim().match(/^(\d{4})-(\d{2})$/);
      if (!m) return null;
      var y = parseInt(m[1], 10), mo = parseInt(m[2], 10);
      if (!isFinite(y) || !isFinite(mo) || mo < 1 || mo > 12) return null;
      return { y: y, mo: mo };
    }

    function addMonths(obj, delta) {
      var total = (obj.y * 12) + (obj.mo - 1) + delta;
      return { y: Math.floor(total / 12), mo: (total % 12) + 1 };
    }

    function fmtYM(obj) {
      return obj.y + '-' + String(obj.mo).padStart(2, '0');
    }

    function buildMonths(startYM, endYM) {
      var s = parseYM(startYM), e = parseYM(endYM);
      if (!s || !e) return [];
      var out = [], cur = { y: s.y, mo: s.mo };
      var endIdx = (e.y * 12) + (e.mo - 1);
      while ((cur.y * 12) + (cur.mo - 1) <= endIdx) {
        out.push(fmtYM(cur));
        cur = addMonths(cur, 1);
      }
      return out;
    }

    var cards = getCards();
    var birdYMs = cards.map(function(card) {
      return (card.dataset.date || '').trim();
    }).filter(function(s) { return /^\d{4}-\d{2}$/.test(s); });

    var nowObj = { y: new Date().getFullYear(), mo: new Date().getMonth() + 1 };
    var minYM = birdYMs.length ? birdYMs.reduce(function(a, b) { return a < b ? a : b; }) : fmtYM(nowObj);
    var maxYM = birdYMs.length ? birdYMs.reduce(function(a, b) { return a > b ? a : b; }) : minYM;

    var PAD = 6;
    var MONTHS = buildMonths(fmtYM(addMonths(parseYM(minYM), -PAD)), fmtYM(addMonths(parseYM(maxYM), PAD)));
    var ymToPos = new Map(MONTHS.map(function(ym, i) { return [ym, i]; }));
    var posToYM = function(pos) { return MONTHS[Math.max(0, Math.min(MONTHS.length - 1, pos))]; };

    var activeSlider = 'max';

    function setThumbZ() {
      if (!minMonthEl || !maxMonthEl) return;
      if (activeSlider === 'min') {
        minMonthEl.style.zIndex = 6; maxMonthEl.style.zIndex = 5;
      } else {
        maxMonthEl.style.zIndex = 6; minMonthEl.style.zIndex = 5;
      }
    }

    function updateRangeFill() {
      if (!minMonthEl || !maxMonthEl) return;
      var minV = parseInt(minMonthEl.value, 10);
      var maxV = parseInt(maxMonthEl.value, 10);
      var minB = parseInt(minMonthEl.min, 10);
      var maxB = parseInt(minMonthEl.max, 10);
      var span = Math.max(1, maxB - minB);
      var leftPct  = ((minV - minB) / span) * 100;
      var rightPct = ((maxV - minB) / span) * 100;

      var bg = 'linear-gradient(to right,' +
        'var(--color-border) 0%,' +
        'var(--color-border) ' + leftPct + '%,' +
        'var(--color-text) ' + leftPct + '%,' +
        'var(--color-text) ' + rightPct + '%,' +
        'var(--color-border) ' + rightPct + '%,' +
        'var(--color-border) 100%)';

      var trackEl = document.getElementById('monthRangeTrack');
      if (trackEl) trackEl.style.background = bg;
    }

    if (minMonthEl && maxMonthEl) {
      minMonthEl.min = '0'; minMonthEl.max = String(MONTHS.length - 1);
      maxMonthEl.min = '0'; maxMonthEl.max = String(MONTHS.length - 1);

      var defaultMin = ymToPos.get(minYM) || 0;
      var defaultMax = ymToPos.get(maxYM) || (MONTHS.length - 1);
      minMonthEl.value = String(defaultMin);
      maxMonthEl.value = String(defaultMax);

      var updateMonthLabels = function() {
        if (minMonthLabel) minMonthLabel.textContent = posToYM(parseInt(minMonthEl.value, 10));
        if (maxMonthLabel) maxMonthLabel.textContent = posToYM(parseInt(maxMonthEl.value, 10));
      };
      updateMonthLabels(); setThumbZ(); updateRangeFill();

      minMonthEl.addEventListener('pointerdown', function() { activeSlider = 'min'; setThumbZ(); });
      minMonthEl.addEventListener('input', function() {
        if (parseInt(minMonthEl.value, 10) > parseInt(maxMonthEl.value, 10)) minMonthEl.value = maxMonthEl.value;
        updateMonthLabels(); setThumbZ(); updateRangeFill(); filterBirds();
      });

      maxMonthEl.addEventListener('pointerdown', function() { activeSlider = 'max'; setThumbZ(); });
      maxMonthEl.addEventListener('input', function() {
        if (parseInt(maxMonthEl.value, 10) < parseInt(minMonthEl.value, 10)) maxMonthEl.value = minMonthEl.value;
        updateMonthLabels(); setThumbZ(); updateRangeFill(); filterBirds();
      });
    }

    if (filterToggleBtn && filterPanel) {
      filterToggleBtn.addEventListener('click', function() {
        var isOpen = filterPanel.classList.toggle('open');
        filterToggleBtn.setAttribute('aria-expanded', String(isOpen));
        filterToggleBtn.textContent = isOpen ? 'Filters ▴' : 'Filters ▾';
      });
    }

    function updateVisibleCount() {
      if (!visibleCountEl) return;
      var visible = getCards().filter(function(c) { return c.style.display !== 'none'; }).length;
      visibleCountEl.textContent = visible;
    }

    function filterBirds() {
      var q = ((searchInput ? searchInput.value : '') || '').toLowerCase().trim();
      var locationCheckboxes = Array.from(document.querySelectorAll('.location-checkbox'));
      var activeLocations = locationCheckboxes.filter(function(cb) { return cb.checked; }).map(function(cb) { return cb.value; });

      getCards().forEach(function(card) {
        var nameEl = card.querySelector('.bird-card-name');
        var name = nameEl ? nameEl.textContent.toLowerCase() : '';
        var imgEl = card.querySelector('.bird-card-img');

        var locAttr = (imgEl ? imgEl.dataset.location : '') || '';
        var imgLocations = locAttr.split(',').map(function(x) { return x.trim(); }).filter(Boolean);

        var matchesText = name.includes(q);
        var matchesLocation = true;
        var matchesDate = true;

        if (minMonthEl && maxMonthEl) {
          var birdYM = (imgEl ? imgEl.dataset.date : '') || '';
          var birdPos = ymToPos.get(birdYM.trim());
          var minPos = parseInt(minMonthEl.value, 10);
          var maxPos = parseInt(maxMonthEl.value, 10);
          matchesDate = birdPos !== undefined ? (birdPos >= minPos && birdPos <= maxPos) : false;
        }

        if (activeLocations.length > 0) {
          matchesLocation = imgLocations.some(function(l) { return activeLocations.includes(l); });
        }

        card.style.display = (matchesText && matchesLocation && matchesDate) ? '' : 'none';
      });

      updateVisibleCount();
    }

    if (searchInput) searchInput.addEventListener('input', filterBirds);

    document.addEventListener('change', function(e) {
      if (e.target && e.target.classList.contains('location-checkbox')) filterBirds();
    });

    if (randomBtn) {
      randomBtn.addEventListener('click', function() {
        var visible = getCards().filter(function(c) { return c.style.display !== 'none'; });
        if (visible.length === 0) return;
        var chosen = visible[Math.floor(Math.random() * visible.length)];
        document.querySelectorAll('.highlight-bird').forEach(function(el) { el.classList.remove('highlight-bird'); });
        chosen.classList.add('highlight-bird');
        chosen.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function() { chosen.classList.remove('highlight-bird'); }, 1200);
      });
    }

    updateVisibleCount();
  }

  // --- SCROLL TO TOP ---
  function setupScrollTop() {
    var btn = document.getElementById('scrollTopBtn');
    if (!btn) return;
    window.addEventListener('scroll', function() {
      if (window.scrollY > 250) btn.classList.add('visible');
      else btn.classList.remove('visible');
    });
    btn.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }
</script>
