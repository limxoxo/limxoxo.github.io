---
---

<div id="lightboxOverlay" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lightbox-close" id="lightboxClose" aria-label="Close photo viewer">✕</button>
  <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous photo">‹</button>

  <img id="lightboxImage" src="" alt="">
  <div id="lightboxCaption">
    <div class="lightbox-name" id="lightboxName"></div>
    <div class="lightbox-meta" id="lightboxMeta"></div>
  </div>

  <button class="lightbox-next" id="lightboxNext" aria-label="Next photo">›</button>
  <div id="lightboxAttribution"></div>
</div>

<style>
  @import '../styles/lightbox.css';
</style>
