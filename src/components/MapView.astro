---
import Lightbox from './Lightbox.astro';
---

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">

<Lightbox />

<div class="map-container">
  <div id="map"></div>
</div>

<style is:global>
  @import '../styles/map.css';
</style>

<script is:inline>
  // Lightbox for map popups
  var lightboxOverlay = document.getElementById('lightboxOverlay');
  var lightboxImage = document.getElementById('lightboxImage');
  var lightboxName = document.getElementById('lightboxName');
  var lightboxMeta = document.getElementById('lightboxMeta');

  function openLightbox(src, title) {
    if (lightboxImage) lightboxImage.src = src;
    if (lightboxName) lightboxName.textContent = title || '';
    if (lightboxMeta) lightboxMeta.textContent = '';
    if (lightboxOverlay) lightboxOverlay.classList.add('show');
  }

  function closeLightbox() {
    if (lightboxOverlay) lightboxOverlay.classList.remove('show');
    if (lightboxImage) lightboxImage.src = '';
    if (lightboxName) lightboxName.textContent = '';
  }

  if (lightboxOverlay) {
    lightboxOverlay.addEventListener('click', function(e) {
      if (e.target === lightboxOverlay || e.target === lightboxImage) closeLightbox();
    });
  }

  var closeBtn = document.getElementById('lightboxClose');
  if (closeBtn) closeBtn.addEventListener('click', function(e) { e.stopPropagation(); closeLightbox(); });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightboxOverlay && lightboxOverlay.classList.contains('show')) closeLightbox();
  });

  window.openLightbox = openLightbox;

  // Load Leaflet dynamically (avoids Astro converting <script src> to type="module")
  function loadScript(src, integrity, cb) {
    var s = document.createElement('script');
    s.src = src;
    if (integrity) { s.integrity = integrity; s.crossOrigin = ''; }
    s.onload = cb;
    document.head.appendChild(s);
  }

  loadScript(
    'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js',
    'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=',
    function() {
      loadScript(
        'https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js',
        null,
        function() {
          Promise.all([
            fetch('/data/bird_data.json').then(function(r) { return r.json(); }),
            fetch('/data/place_coord.json').then(function(r) { return r.json(); })
          ]).then(function(results) {
            initMap(results[0], results[1]);
          }).catch(function(err) { console.error('Error loading map data:', err); });
        }
      );
    }
  );

  function initMap(birds, places) {
    var map = L.map('map').setView([-40.5, 146.0], 5);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    var markers = L.markerClusterGroup();

    var birdsByPlace = {};
    birds.forEach(function(bird) {
      if (!bird.place) return;
      if (!birdsByPlace[bird.place]) birdsByPlace[bird.place] = [];
      birdsByPlace[bird.place].push(bird);
    });

    Object.keys(places).forEach(function(placeName) {
      var placeInfo = places[placeName];
      if (!placeInfo || !placeInfo.coords) return;

      var birdsHere = birdsByPlace[placeName] || [];
      if (birdsHere.length === 0) return;

      var marker = L.marker(placeInfo.coords);

      var thumbsHtml = birdsHere.map(function(bird) {
        var safeTitle = bird.title.replace(/'/g, "\\'");
        return '<img' +
          ' src="' + bird.thumbAvif + '"' +
          ' class="popup-thumb"' +
          ' alt="' + bird.title + '"' +
          ' loading="lazy"' +
          ' decoding="async"' +
          ' onclick="openLightbox(\'' + bird.largeAvif + '\', \'' + safeTitle + '\')"' +
        '>';
      }).join('');

      var popupHtml = '<div class="popup-gallery-wrapper">' +
        '<div class="popup-gallery-title">' + placeName + '</div>' +
        '<div class="popup-gallery-strip">' + thumbsHtml + '</div>' +
      '</div>';

      marker.bindPopup(popupHtml);
      markers.addLayer(marker);
    });

    map.addLayer(markers);

    if (markers.getLayers().length > 0) {
      map.fitBounds(markers.getBounds(), { padding: [40, 40] });
    }
  }
</script>
